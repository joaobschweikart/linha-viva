<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espaco_s"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_aviso"
    android:paddingStart="@dimen/espaco_m"
    android:paddingEnd="@dimen/espaco_m"
    android:paddingVertical="@dimen/espaco_m">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/ic_aviso"
        app:tint="@color/ambar_aviso"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tituloAviso"
            style="@style/Texto.Corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Aviso de operação" />

        <TextView
            android:id="@+id/descricaoAviso"
            style="@style/Texto.Apoio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            tools:text="Linha 302 com desvio temporário no Centro" />
    </LinearLayout>
</LinearLayout>
