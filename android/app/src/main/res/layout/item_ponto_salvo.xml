<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espaco_s"
    app:cardCornerRadius="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingHorizontal="@dimen/espaco_m"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_pin_pequeno"
            app:tint="@color/azul_primario"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/espaco_s"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nomePontoSalvo"
                style="@style/Texto.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Av. Getúlio Vargas, 1240" />

            <TextView
                android:id="@+id/bairroPontoSalvo"
                style="@style/Texto.Apoio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Centro" />
        </LinearLayout>

        <TextView
            android:id="@+id/distanciaPontoSalvo"
            style="@style/Texto.Apoio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_s"
            android:textSize="12sp"
            tools:text="120 m" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
