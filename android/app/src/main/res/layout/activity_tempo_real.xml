<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_cabecalho"
        android:paddingHorizontal="@dimen/espaco_s"
        android:paddingVertical="@dimen/espaco_s">

        <ImageButton
            android:id="@+id/botaoVoltar"
            android:layout_width="@dimen/alvo_toque"
            android:layout_height="@dimen/alvo_toque"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_voltar"
            app:tint="@color/branco"
            android:contentDescription="@string/cd_voltar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/espaco_xs"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tituloTempoReal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/branco"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Linha 215 · Efapi" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/pontoAoVivo"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_ponto_verde" />

                <TextView
                    android:id="@+id/statusTempoReal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_sobre_azul_suave"
                    android:textSize="12sp"
                    tools:text="Ao vivo · atualizado há 12 s" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/botaoFavorito"
            android:layout_width="@dimen/alvo_toque"
            android:layout_height="@dimen/alvo_toque"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_estrela_contorno"
            app:tint="@color/branco"
            android:contentDescription="@string/cd_favorito" />
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/mapaTempoReal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_folha_inferior"
        android:elevation="12dp"
        android:paddingHorizontal="@dimen/espaco_m"
        android:paddingTop="@dimen/espaco_m"
        android:paddingBottom="@dimen/espaco_s">

        <include
            android:id="@+id/bannerOfflineTempo"
            layout="@layout/view_banner_offline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espaco_s" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rotuloChegada"
                    style="@style/Texto.Apoio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chega_ao_seu_ponto_em" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tempoChegada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto_primario"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        tools:text="3 min" />

                    <TextView
                        android:id="@+id/distanciaVeiculo"
                        style="@style/Texto.Apoio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_s"
                        android:layout_marginBottom="4dp"
                        tools:text="· 850 m" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blocoLotacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_pill_tempo_real"
                android:paddingHorizontal="@dimen/espaco_m"
                android:paddingVertical="@dimen/espaco_s">

                <TextView
                    style="@style/Texto.Apoio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/verde_tempo_real"
                    android:text="@string/lotacao" />

                <TextView
                    android:id="@+id/valorLotacao"
                    style="@style/Texto.Corpo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/verde_tempo_real"
                    tools:text="Média" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_acessivel"
                app:tint="@color/texto_secundario"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/acessibilidadeVeiculo"
                style="@style/Texto.Apoio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_xs"
                android:textSize="12sp"
                tools:text="Veículo acessível" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="@dimen/espaco_m"
                android:src="@drawable/ic_onibus"
                app:tint="@color/texto_secundario"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/prefixoVeiculo"
                style="@style/Texto.Apoio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_xs"
                android:textSize="12sp"
                tools:text="Prefixo 1042" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_m"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoAvisar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@drawable/ic_sino"
                app:iconGravity="textStart"
                android:textSize="13sp"
                tools:text="Avisar em 2 paradas" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoVerPonto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_s"
                android:minHeight="@dimen/alvo_toque"
                app:icon="@drawable/ic_pin_pequeno"
                app:iconGravity="textStart"
                android:textSize="13sp"
                android:text="@string/ver_ponto" />
        </LinearLayout>

        <TextView
            android:id="@+id/rodapeTempoReal"
            style="@style/Texto.Apoio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/texto_terciario"
            android:text="@string/aviso_tempo_real_estimado" />
    </LinearLayout>
</LinearLayout>
